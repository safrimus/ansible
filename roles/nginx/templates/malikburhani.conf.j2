server {
    listen 80;
    server_name localhost;

    # Max upload size for database restores (10MB)
    client_max_body_size 10M;

    access_log /var/log/nginx/malikburhani-access.log;
    error_log /var/log/nginx/malikburhani-error.log;

    # 1. FRONTEND: Serve the UI files
    root /var/www/pos;
    index index.html;

    # 2. API PROXY: Send all /api requests to Gunicorn
    location /api/ {
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Connection to Gunicorn
        proxy_pass http://unix:{{ lookup('env', 'HOME') }}/malikburhani/gunicorn.sock;

        # Timeouts for heavy database tasks (5 minutes)
        proxy_read_timeout 300s;
    }

    # 3. BACKEND STATIC: Serve Django Admin CSS/Images
    location /static/ {
        alias {{ lookup('env', 'HOME') }}/malikburhani/static/;
    }

    # 4. SPA ROUTING: Ensure UI refreshes don't 404
    location / {
        try_files $uri $uri/ /index.html;
    }
}

